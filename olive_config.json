{
  "input_model": {
    "type": "PyTorchModel",
    "config": {
      "model_path": "models/confessions-sample_epoch_50.pt",
      "model_loader": "_model_loader",
      "model_script": "scripts/art-piece/olive_model_loader.py",
      "io_config": "_io_config",
      "dummy_inputs_func": "_dummy_inputs"
    }
  },
  "systems": {
    "local_system": {
      "type": "LocalSystem",
      "config": {
        "accelerators": [
          {
            "device": "cpu",
            "execution_providers": [
              "CPUExecutionProvider"
            ]
          }
        ]
      }
    }
  },
  "passes": {
    "onnx_conversion": {
      "type": "OnnxConversion",
      "target_opset": 18
    },
    "onnx_dynamic_quantization": {
      "type": "OnnxDynamicQuantization"
    }
  },
  "engine": {
    "host": "local_system",
    "target": "local_system",
    "cache_dir": ".olive_cache",
    "output_dir": "models",
    "log_severity_level": 0
  }
}
